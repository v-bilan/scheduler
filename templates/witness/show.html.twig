{% extends 'base.html.twig' %}

{% block title %}Witness{% endblock %}

{% block body %}
    <h1>Witness</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ witness.id }}</td>
            </tr>
            <tr>
                <th>FullName</th>
                <td>{{ witness.fullName }}</td>
            </tr>
            <tr>
                <th>Active</th>
                <td>{{ witness.active }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn btn-primary m-1" href="{{ path('app_witness_index') }}">back to list</a>
    <br/>
    <a class="btn btn-primary m-1" href="{{ path('app_witness_edit', {'id': witness.id}) }}">edit</a>

    {{ include('witness/_delete_form.html.twig') }}
    <h2>Last tasks</h2>
    <table class="table">
        <thead>
            <tr>
              
                <th>Date</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
        {% for task in lastTasks %}
            <tr>
                <td>{{ task.date | date('Y-m-d') }}</td>
                <td>{{ task.Role.name }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
